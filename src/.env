COMPOSE_PROJECT_NAME=strive

# Compose supports declaring default environment variables in an environment file named .env placed in the folder docker-compose command is executed from (current working directory).
# Compose expects each line in an env file to be in VAR=VAL format. Lines beginning with # (i.e. comments) are ignored, as are blank lines.
# Note: Values present in the environment at runtime will always override those defined inside the .env file. Similarly, values passed via command-line arguments take precedence as well.

# The IP below should be swapped to your real IP or DNS name, like 192.168.88.248, etc. if testing from remote browsers or mobile devices

# Use this values to run the app locally
ANNOUNCED_IP=127.0.0.1
SITE_HOST=localhost
FRONTEND_DNS_OR_IP=localhost
STRIVE_TOKEN_SECRET=57ca7f82bf274a3a97f45316f366ad0d
STRIVE_API_KEY=a57e504a1ac0410281a28bc38e8e1261

MEDIASOUP_MIN_PORT=40000 # Minimun RTC port for ICE, DTLS, RTP, etc.
MEDIASOUP_MAX_PORT=49999 # Maximum RTC port for ICE, DTLS, RTP, etc.

# TURN server (coturn) that relays media for participants behind strict firewalls. Browsers connect to TURN_HOST, which
# has to be the public DNS name or IP of this server. Use a long random TURN_SECRET in production.
TURN_HOST=localhost
TURN_SECRET=0e7a5f3c2b1d4e6f8a9b0c1d2e3f4a5b
TURN_MIN_PORT=50000
TURN_MAX_PORT=50199

APP_ENVIRONMENT=Production

# Recording (optional, start with `./compose.sh --profile recording up -d`). Development defaults, use long random
# values in production. Recordings are stored in Cloudflare R2: compose.sh reads the credentials from the file
# .env.recording (R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET), which is never committed.
# Without that file a local S3-compatible storage is started instead (development only).
RECORDER_SHARED_SECRET=dev-recorder-shared-secret-change-me
RECORDER_TOKEN_SECRET=dev-recorder-token-secret-change-me-0123456789
