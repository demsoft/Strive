{
  "name": "strive-recorder",
  "version": "1.0.0",
  "description": "Records Strive conferences: joins as a hidden participant in a headless browser and captures it with ffmpeg",
  "main": "dist/index.js",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "fastify": "^5.2.0",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
