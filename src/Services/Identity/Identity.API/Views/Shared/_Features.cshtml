@inject Identity.API.BrandInfo Brand
@if (Brand.IsArena)
{
<section class="features" aria-label="About Arena">
    <h2>Football, <span class="gradient-text">live.</span></h2>
    <p class="lead">Watch lower league, school and club matches that their organizers stream live. Get a pass for a match or a season and watch from your phone.</p>
    <ul>
        <li><span class="ico">⚽</span><div><strong>Live match streams</strong><span>Straight in the browser, no download.</span></div></li>
        <li><span class="ico">🎟️</span><div><strong>Passes in naira</strong><span>Pay by card, bank transfer or USSD. Come back to the same pass any time.</span></div></li>
        <li><span class="ico">💬</span><div><strong>Match chat</strong><span>Talk about the game with the other fans while it is on.</span></div></li>
        <li><span class="ico">⏺️</span><div><strong>Replays</strong><span>Organizers record their matches so you can watch again.</span></div></li>
    </ul>
</section>
}
else if (Brand.IsGbedu)
{
<section class="features" aria-label="About Gbedu">
    <h2>Go live. <span class="gradient-text">Bring people together.</span></h2>
    <p class="lead">Teach, perform and share what you know in live sessions that people join from their phone. Paid sessions in naira are coming soon.</p>
    <ul>
        <li><span class="ico">🎥</span><div><strong>Live video sessions</strong><span>For classes, workshops, shows and communities, straight in the browser, no download.</span></div></li>
        <li><span class="ico">🖥️</span><div><strong>Share your screen, with sound</strong><span>Show slides or play a video and everybody hears it.</span></div></li>
        <li><span class="ico">⏺️</span><div><strong>Record and share</strong><span>Record a session and share the link when it ends.</span></div></li>
        <li><span class="ico">👥</span><div><strong>Polls, whiteboard and breakout rooms</strong><span>Keep your audience taking part.</span></div></li>
        <li><span class="ico">🎹</span><div><strong>Studio sound for music</strong><span>A shared click, a lesson mode and a track for every voice and instrument.</span></div></li>
    </ul>
</section>
}
else
{
<section class="features" aria-label="About Strive">
    <h2>Meetings that feel <span class="gradient-text">effortless</span></h2>
    <p class="lead">Video meetings for teams, classes and communities. No downloads, just a link.</p>
    <ul>
        <li><span class="ico">🎥</span><div><strong>HD video and clear sound</strong><span>On your computer, tablet or phone, straight in the browser.</span></div></li>
        <li><span class="ico">🖥️</span><div><strong>Share your screen, with sound</strong><span>Show slides or play a video and everybody hears it.</span></div></li>
        <li><span class="ico">▶️</span><div><strong>Watch a YouTube video together</strong><span>Paste a link, everybody watches in sync and you control it.</span></div></li>
        <li><span class="ico">⏺️</span><div><strong>Record and share</strong><span>Record a meeting and share the link when it ends.</span></div></li>
        <li><span class="ico">🚪</span><div><strong>Lobby, hand raise and reactions</strong><span>You decide who joins, everybody can take part.</span></div></li>
        <li><span class="ico">👥</span><div><strong>Breakout rooms, polls and a whiteboard</strong><span>Everything for workshops and lessons in one place.</span></div></li>
    </ul>
</section>
}
