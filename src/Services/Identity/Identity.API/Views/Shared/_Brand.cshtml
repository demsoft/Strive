@inject Identity.API.BrandInfo Brand
@if (Brand.IsArena)
{
<svg width="30" height="30" viewBox="0 0 32 32" role="img" aria-label="Arena">
    <defs>
        <linearGradient id="brand-gradient" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#22c55e" />
            <stop offset="1" stop-color="#facc15" />
        </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill="url(#brand-gradient)" />
    <circle cx="16" cy="16" r="9" fill="none" stroke="#fff" stroke-width="2.2" />
    <path d="M16 11.2l3.7 2.7-1.4 4.4h-4.6l-1.4-4.4zM16 11.2V7.2M19.7 13.9l3.8-1.2M18.3 18.3l2.4 3.2M13.7 18.3l-2.4 3.2M12.3 13.9l-3.8-1.2" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
</svg>
}
else if (Brand.IsGbedu)
{
<svg width="30" height="30" viewBox="0 0 32 32" role="img" aria-label="Gbedu">
    <defs>
        <linearGradient id="brand-gradient" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ff9f1c" />
            <stop offset="1" stop-color="#ff4d6d" />
        </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill="url(#brand-gradient)" />
    <circle cx="16" cy="16" r="3" fill="#fff" />
    <path d="M10.6 10.6a7.6 7.6 0 0 0 0 10.8M21.4 10.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
    <path d="M6.8 6.8a13 13 0 0 0 0 18.4M25.2 6.8a13 13 0 0 1 0 18.4" fill="none" stroke="#fff" stroke-opacity=".6" stroke-width="2.2" stroke-linecap="round" />
</svg>
}
else
{
<svg width="30" height="30" viewBox="0 0 32 32" role="img" aria-label="Strive">
    <defs>
        <linearGradient id="brand-gradient" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#7c5cff" />
            <stop offset="1" stop-color="#22d3ee" />
        </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill="url(#brand-gradient)" />
    <path d="M21.5 11.2c-1.2-1.4-3-2.2-5.2-2.2-3 0-5 1.5-5 3.7 0 2.2 1.7 3.1 4.7 3.8 2.3.5 3.4.9 3.4 2 0 1.1-1.2 1.8-3 1.8-1.7 0-3.1-.7-4.1-1.9" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" />
</svg>
}
