@inject Identity.API.AppUrls App
@using Duende.IdentityServer.Extensions
@{
    string name = null;
    if (!true.Equals(ViewData["signed-out"]))
    {
        name = Context.User?.GetDisplayName();
    }
}

<header class="page-header">
    <a href="@App.Home" class="brand">
        <partial name="_Brand" />
        Strive
    </a>

    @if (!string.IsNullOrWhiteSpace(name))
    {
        <div class="user-menu">
            <span>@name</span>
            <a class="btn btn-secondary" asp-action="Logout" asp-controller="Account">Sign out</a>
        </div>
    }
</header>
