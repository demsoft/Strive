@inject Identity.API.AppUrls App
@model Identity.API.Quickstart.Home.ErrorViewModel

@{
    var error = Model?.Error?.Error;
    var errorDescription = Model?.Error?.ErrorDescription;
    var request_id = Model?.Error?.RequestId;
}

<div class="auth-card error-page">
    <h1>Something <span class="gradient-text">went wrong</span></h1>
    <p class="subtitle">Sorry, there was an error@(error != null ? ": " + error : "").</p>

    @if (errorDescription != null)
    {
        <div class="alert alert-danger">@errorDescription</div>
    }

    <a class="btn btn-secondary btn-block" href="@App.Home">Back to Strive</a>

    @if (request_id != null)
    {
        <div class="request-id">Request Id: @request_id</div>
    }
</div>
