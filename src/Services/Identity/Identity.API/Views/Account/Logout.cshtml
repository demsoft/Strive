@model Identity.API.Quickstart.Account.LogoutViewModel

<div class="auth-card logout-page">
    <h1>Sign <span class="gradient-text">out?</span></h1>
    <p class="subtitle">You'll need to sign in again to join your meetings.</p>

    <form asp-action="Logout">
        <input type="hidden" name="logoutId" value="@Model.LogoutId" />
        <button class="btn btn-primary btn-block">Yes, sign me out</button>
    </form>
</div>
