@model Identity.API.Quickstart.Account.LoggedOutViewModel

@{
    // set this so the layout rendering sees an anonymous user
    ViewData["signed-out"] = true;
}

<div class="auth-card logged-out-page">
    <h1>You're <span class="gradient-text">signed out</span></h1>
    <p class="subtitle">Thanks for stopping by. See you at the next meeting.</p>

    @if (Model.PostLogoutRedirectUri != null)
    {
        <a class="btn btn-primary btn-block PostLogoutRedirectUri" href="@Model.PostLogoutRedirectUri">Return to @Model.ClientName</a>
    }

    @if (Model.SignOutIframeUrl != null)
    {
        <iframe width="0" height="0" class="signout" src="@Model.SignOutIframeUrl"></iframe>
    }
</div>

@section scripts
{
    @if (Model.AutomaticRedirectAfterSignOut)
    {
        <script src="~/js/signout-redirect.js"></script>
    }
}
