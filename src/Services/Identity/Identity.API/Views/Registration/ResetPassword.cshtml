@model Identity.API.Quickstart.Account.ResetPasswordModel

<div class="auth-card">
    <h1>Choose a new <span class="gradient-text">password</span></h1>
    <p class="subtitle">Use at least 10 characters. A few random words make a good password.</p>

    <partial name="_ValidationSummary" />

    <form asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="form-group">
            <label asp-for="Password"></label>
            <input class="form-control" type="password" asp-for="Password" autocomplete="new-password" autofocus>
        </div>
        <div class="actions">
            <button class="btn btn-primary" type="submit">Change password</button>
        </div>
    </form>
</div>
