{
  "name": "strive-sfu",
  "version": "1.0.0",
  "main": "index.ts",
  "author": "Vincent",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "debug": "tsx watch --inspect src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc",
    "start": "node dist/index.js",
    "lint:base": "eslint --ext .js,.json,.ts",
    "lint": "yarn lint:base src",
    "test": "jest"
  },
  "lint-staged": {
    "src/**/*.{ts,js,json}": [
      "yarn lint:base --fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn typecheck && lint-staged"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/amqplib": "^0.10.8",
    "@types/async-lock": "^1.1.2",
    "@types/cors": "^2.8.10",
    "@types/debug": "^4.1.5",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.170",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "eslint": "^7.28.0",
    "eslint-config-prettier": "8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "jest": "^29.7.0",
    "lint-staged": "^11.0.0",
    "prettier": "^2.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@lifeomic/attempt": "^3.0.0",
    "amqplib": "^0.10.9",
    "async-lock": "^1.3.0",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "debug": "^4.2.0",
    "express": "^4.22.3",
    "express-jwt": "^8.5.1",
    "lightship": "^6.8.0",
    "lodash": "4.17.21",
    "mediasoup": "3.28.0"
  }
}
