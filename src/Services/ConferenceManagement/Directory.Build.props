<Project>
    <ItemGroup>
        <!--
            GHSA-6c8g-7p36-r338: directory traversal in SharpCompress' WriteToDirectory (archive extraction).
            SharpCompress 0.30.1 comes in through MongoDB.Driver (zlib wire compression), which never extracts
            archives. The patched SharpCompress 0.48 removed types MongoDB.Driver 2.x needs: with compressors=zlib
            the service crashes on startup (TypeLoadException). Remove this once MongoDB.Driver is on 3.x.
        -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-6c8g-7p36-r338" />
    </ItemGroup>
</Project>
