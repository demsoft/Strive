{
  "Authentication": {
    "Authority": "http://localhost:55105"
  },
  "KeyValueDatabase": {
    "UseInMemory": true
  },
  "RabbitMq": {
    "UseInMemory": true
  },
  "Admin": {
    "SamplingEnabled": false
  },
  "Turn": {
    "Urls": [
      "turn:turn.example.com:3478?transport=udp",
      "turn:turn.example.com:3478?transport=tcp"
    ],
    "Secret": "integration-test-secret"
  },
  "MongoDb": {
    "ConnectionString": "set in ConfigureWebHost()",
    "DatabaseName": "Strive",
    "CollectionNames": {
      "Conference": "Conference"
    }
  },
  "Recording": {
    "Enabled": true,
    "RetentionDays": 30,
    "MaxDurationMinutes": 120,
    "Storage": {
      "ServiceUrl": "https://storage.test",
      "Bucket": "strive-recordings",
      "AccessKeyId": "test",
      "SecretAccessKey": "test"
    },
    "Recorder": {
      "BaseUrl": "http://recorder.test",
      "SharedSecret": "integration-recorder-secret",
      "TokenSecret": "integration-recorder-token-secret-0123456789"
    }
  }
}
