# Production settings for the Windows server (deploy/windows/README.md). Copy to .env.production (git ignores it) or let
# deploy/windows/New-ProductionEnv.ps1 create it with random secrets. Never commit the real file.
COMPOSE_PROJECT_NAME=strive-prod
APP_ENVIRONMENT=Production

# hostnames: meet.<domain> is the web app, identity./api./sfu.<domain> are the services
SITE_HOST=goserp.co.uk
FRONTEND_DNS_OR_IP=meet.goserp.co.uk
# more addresses that serve the same web app, e.g. another brand on its own host name (comma separated, no https://)
# each needs a DNS record, a binding in IIS (Setup-Iis.ps1 does it) and, for sign in with Google, the redirect address
# https://<host>/account/signin-google in the Google console
EXTRA_APP_HOSTS=
# the public IPv4 address of the server: browsers send their media here
ANNOUNCED_IP=173.208.144.83

STRIVE_TOKEN_SECRET=
STRIVE_API_KEY=
TURN_HOST=turn.goserp.co.uk
TURN_SECRET=

# media server: one udp+tcp port per worker, MAX = MIN + workers - 1 (open exactly these ports in the firewalls)
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40003
MEDIASOUP_NUM_WORKERS=4

# accounts
ACCOUNTS_MODE=Accounts
ACCOUNTS_REQUIRE_EMAIL_CONFIRMATION=false
ACCOUNTS_ALLOWED_EMAIL_DOMAINS=
# server administrators: they see the admin overview (/admin), after their next sign in. Comma separated.
ACCOUNTS_ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# email through the Brevo API (Brevo -> SMTP & API -> API keys). SMTP_FROM must be a sender or domain that is validated in
# Brevo (Senders, domains & dedicated IPs), otherwise Brevo refuses the mails.
BREVO_API_KEY=
SMTP_FROM=Strive <no-reply@goserp.co.uk>
# alternatively a normal SMTP server instead of BREVO_API_KEY:
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_TLS=true
#SMTP_USER=
#SMTP_PASSWORD=

# paid sessions (optional): the Paystack secret key (test key first: sk_test_...). Only here, never in a tracked file.
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=
PLATFORM_COMMISSION_PERCENT=10
# passes that renew themselves: the card of the first payment is charged again every 30 days until the person stops it.
# Leave false until you have tried it with Paystack test cards (see the pull request: charge_authorization with a split).
#PAYMENTS_AUTO_RENEW=false
# reminder mails: ticket holders get a mail this long before a session starts (needs BREVO_API_KEY above). The sender
# defaults to SMTP_FROM; set REMINDERS_FROM to send them as Gbedu, for example "Gbedu <no-reply@goserp.co.uk>".
#REMINDERS_ENABLED=true
#REMINDERS_LEAD_MINUTES=60
#REMINDERS_FROM=

# recording (optional). Leave RECORDING_ENABLED=false to run without it.
RECORDING_ENABLED=false
RECORDER_SHARED_SECRET=
RECORDER_TOKEN_SECRET=
RECORDING_STORAGE_ENDPOINT=https://<r2 account id>.r2.cloudflarestorage.com
RECORDING_STORAGE_BUCKET=
RECORDING_STORAGE_ACCESS_KEY_ID=
RECORDING_STORAGE_SECRET_ACCESS_KEY=
