# Accounts for development. Copy this file to .env.identity (never committed) and fill in the values.
# With this file ./compose.sh runs the app with real accounts (email and password, Google) instead of the demo sign in.

# Google refuses http://*.localhost as a redirect address and wants a real domain. localtest.me and all its subdomains
# point to 127.0.0.1 (no hosts file needed), so the app runs on https://localtest.me. You can use any other domain that
# points to 127.0.0.1 as well. After changing it, create the Google client below again with the new address.
SITE_HOST=localtest.me
FRONTEND_DNS_OR_IP=localtest.me

# Sign in with Google (optional, the button only shows when both values are set).
# Google Cloud console -> APIs & Services -> Credentials -> Create OAuth client ID -> Web application:
#   Authorized JavaScript origins:  https://localtest.me
#   Authorized redirect URIs:       https://identity.localtest.me/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these email domains may create an account (comma separated). Empty: everybody. People who have an account
# stay in when a domain is removed from the list.
ACCOUNTS_ALLOWED_EMAIL_DOMAINS=

# Must new accounts confirm their email address before they can sign in? Off for now.
ACCOUNTS_REQUIRE_EMAIL_CONFIRMATION=false

# Emails (confirm email, reset password). Without SMTP_HOST a local inbox is started: http://localhost:8025
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_TLS=true
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=Strive <no-reply@example.com>
